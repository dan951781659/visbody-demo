{
  "name": "motionstation-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/start-expo.mjs",
    "start:lan": "node scripts/start-expo.mjs",
    "start:tunnel": "expo start --tunnel",
    "start:share": "expo start --tunnel --clear",
    "android": "node scripts/start-expo.mjs --android",
    "ios": "node scripts/start-expo.mjs --ios",
    "web": "node scripts/allow-cursor-preview-cors.mjs && expo start --web",
    "export:web": "expo export --platform web --output-dir dist-web",
    "preview:web": "npx serve dist-web -s -l tcp://0.0.0.0:4173",
    "share:lan": "node scripts/share-lan.mjs",
    "share:lan:serve": "node scripts/share-lan.mjs --serve-only",
    "lint": "tsc --noEmit",
    "dev-backup": "dev-backup serve",
    "dev-backup:env": "set -a && source .dev-backup.env && set +a && dev-backup serve"
  },
  "dependencies": {
    "@expo-google-fonts/archivo-black": "^0.4.1",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-screen-orientation": "~9.0.9",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.2"
  }
}
